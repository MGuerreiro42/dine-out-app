{
	"$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!public/mockServiceWorker.js", "!assets", "!src/global.css"]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		},
		"domains": {
			"react": "recommended"
		}
	},
	"formatter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	}
}
