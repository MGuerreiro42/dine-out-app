# Optional personal override. Copy to .env.local (gitignored); delete when done.
# Precedence, highest first: .env.<mode>.local > .env.local > .env.<mode> > .env
# Applies to `expo start`, `expo export` and `expo run:android --variant release`.
# EAS builds (cloud and --local) upload git-tracked files only and never see it.

# Example: point dev at the Render backend to test against production data.
EXPO_PUBLIC_API_BASE_URL=https://dine-out-backend.onrender.com
