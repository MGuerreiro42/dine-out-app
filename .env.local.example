# Optional personal override. Copy to .env.local (gitignored).
# Precedence: shell/EAS env > .env.<mode>.local > .env.local > .env.<mode> > .env
# Local development already uses .env.development (http://localhost:3000).
# To test dev against production: `npx eas-cli env:pull --environment production`
# (writes .env.local), then delete .env.local afterwards.
# EAS builds (cloud and --local) never read .env.local: gitignored files are excluded from the build archive.
# Physical iOS device: set the host's LAN IP here.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
